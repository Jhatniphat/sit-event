{
  "name": "sit-event-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev-mobile": "concurrently \"vite --mode mobile --host 127.0.0.1\" \"lt --port 5173\"",
    "check-env": "node check-env.ts",
    "predev": "npm list --depth=0 && npm run check-env ",
    "predev-mobile": "node check-env.ts .env.mobile",
    "build": "vue-tsc -b && vite build --base=/capstone25/cp25tt1/",
    "preview": "vite preview",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "test:unit": "cypress run --component",
    "test:unit:dev": "cypress open --component",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.544.0",
    "pinia": "^3.0.3",
    "qrcode.vue": "^3.6.0",
    "reka-ui": "^2.6.0",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-qrcode-reader": "^5.7.3",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.7",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "cypress": "^15.3.0",
    "daisyui": "^5.4.3",
    "eslint": "^9.33.0",
    "eslint-plugin-cypress": "^5.1.1",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.5.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "start-server-and-test": "^2.1.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vue-tsc": "^3.1.0"
  }
}
