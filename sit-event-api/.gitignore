# .gitignore for Node / TypeScript backend (sit-event-api)

# Node modules
node_modules/
generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
build/
out/
lib/

# TypeScript
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
.env.test

# Coverage
coverage/
.nyc_output/

# Test & tooling
jest-cache/
playwright-report/
.vitest/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Misc
.cache/
tmp/
temp/
*.tmp
pids/
*.pid
*.seed
*.pid.lock

# Secrets and local config
secrets.json
local.settings.json