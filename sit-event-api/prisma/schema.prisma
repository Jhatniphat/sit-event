generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ORGANIZER
  INTERNAL_STUDENT
  EXTERNAL_STUDENT
}

enum TargetAudience {
  EXTERNAL_STUDENT
  INTERNAL_STUDENT
  TEACHER
  PUBLIC
}

enum RoleInSchool {
  STUDENT
  TEACHER
  STAFF
}

enum EventTag {
  SPEAK
  EDUCATION
  WORKSHOP
  SEMINAR
  COMPETITION
  SOCIAL
  CAREER
}

enum FormFieldType {
  TEXT
  RATING_SCALE
  CHECKBOX
  RADIO
}

enum FieldName {
  FULL_USER_NAME
  EVENT_NAME
}

enum StaffStatus {
  PENDING
  ACCEPTED
  WITHDRAWN
  REFUSED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  firstName               String
  lastName                String
  phoneNumber             String?
  age                     Int?
  school                  String?
  roleInSchool            RoleInSchool?
  userRole                UserRole  @default(EXTERNAL_STUDENT)
  province                String?
  dietaryRequirements     String?
  notificationPreferences Boolean   @default(false)
  createdAt               DateTime  @default(now()) @db.Timestamptz
  updatedAt               DateTime  @updatedAt @db.Timestamptz

  // Relations
  eventRegistrations EventRegistration[]
  eventsAsStaff      EventStaff[]
  formSubmissions    EventFormSubmission[]
  createdEvents      Event[]               @relation("EventCreator")

  @@map("users")
}

model Event {
  id                   String           @id @default(uuid())
  name                 String
  description          String           @db.Text
  images               String[] //MinIO S3
  thumbnail            String?
  registrationOpenDate DateTime         @db.Timestamptz
  registrationEndDate  DateTime         @db.Timestamptz
  eventStartDate       DateTime         @db.Timestamptz
  eventEndDate         DateTime         @db.Timestamptz
  allowOnSiteRegister  Boolean          @default(false)
  targetAudience       TargetAudience[]
  tags                 EventTag[]
  activityHours        Int?
  invitation           String?          @db.Text
  website              String?
  needWifi             Boolean          @default(false)
  certificateCriteria  String?          @db.Text
  createdAt            DateTime         @default(now()) @db.Timestamptz
  updatedAt            DateTime         @updatedAt @db.Timestamptz

  // Relations
  sessions      EventSession[]
  registrations EventRegistration[]
  staff         EventStaff[]
  faqs          EventFAQ[]
  badges        EventBadge[]
  form          EventForm?
  creator       User?                 @relation("EventCreator", fields: [creatorId], references: [id])
  creatorId     String?
  certificated  CertificateTemplate[]

  @@map("events")
}

model EventSession {
  id             String   @id @default(uuid())
  eventId        String
  name           String
  description    String?  @db.Text
  startTime      DateTime @db.Timestamptz
  endTime        DateTime @db.Timestamptz
  location       String?
  maxSeats       Int
  availableSeats Int
  pointsAwarded  Int?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  // Relations
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@map("event_sessions")
}

model EventRegistration {
  id                String    @id @default(uuid())
  userId            String
  eventId           String
  sessionId         String?
  status            RegistrationStatus @default(PENDING)
  registeredAt      DateTime  @default(now()) @db.Timestamptz
  approvedAt        DateTime?          @db.Timestamptz
  attended          Boolean   @default(false)
  checkedInAt       DateTime? @db.Timestamptz
  certificateIssued Boolean   @default(false)
  pointsEarned      Int?
  notes             String?   @db.Text

  // Relations
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session EventSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId, sessionId])
  @@map("event_registrations")
}

model EventStaff {
  id        String      @id @default(uuid())
  eventId   String
  userId    String
  eventRole String
  status    StaffStatus @default(PENDING)
  createdAt DateTime    @default(now()) @db.Timestamptz

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_staff")
}

model EventFAQ {
  id        String   @id @default(uuid())
  eventId   String
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0) // For priority of question
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_faqs")
}

model EventForm {
  id          String   @id @default(uuid())
  eventId     String   @unique // 1 Event มีได้ 1 Form
  title       String
  description String?  @db.Text
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields      EventFormField[]
  submissions EventFormSubmission[]

  @@map("event_forms")
}

model EventFormField {
  id         String        @id @default(uuid())
  formId     String
  question   String
  fieldType  FormFieldType
  options    String[] // สำหรับ CHECKBOX และ RADIO
  isRequired Boolean       @default(false)
  order      Int           @default(0)

  // Relations
  form    EventForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers EventFormAnswer[]

  @@map("event_form_fields")
}

model EventFormSubmission {
  id          String   @id @default(uuid())
  formId      String
  userId      String
  submittedAt DateTime @default(now()) @db.Timestamptz

  // Relations
  form    EventForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers EventFormAnswer[]

  @@unique([formId, userId]) // 1 User ส่งได้ 1 ครั้งต่อ 1 Form
  @@map("event_form_submissions")
}

model EventFormAnswer {
  id           String  @id @default(uuid())
  submissionId String
  fieldId      String
  answer       String? @db.Text // เก็บคำตอบเป็น Text, ตัวเลข, หรือค่าที่เลือก

  // Relations
  submission EventFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      EventFormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("event_form_answers")
}

model EventBadge {
  id             String   @id @default(uuid())
  eventId        String
  name           String
  description    String?
  imageUrl       String?
  pointsRequired Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_badges")
}

model CertificateTemplate {
  id                String  @id @default(uuid())
  eventId           String
  templateFilepath  String
  signatureFilepath String?
  signatureX        Int?
  signatureY        Int?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  element CertificateElement[]
}

model CertificateElement {
  id                   String    @id @default(uuid())
  templateId           String
  CertificateFieldName FieldName
  placeHolder          String
  x                    Int
  y                    Int
  fontSize             Int
  fontFamily           String
  color                String
  fontWeight           String
  textAlign            String

  certificateTemplate CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}
